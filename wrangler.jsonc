{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleek",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENING_FEED",
        "class_name": "OpeningFeed"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-opening-feed",
      "new_sqlite_classes": [
        "OpeningFeed"
      ]
    }
  ]
}
